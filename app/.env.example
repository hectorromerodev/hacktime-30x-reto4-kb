# Copiar a .env y ajustar. NUNCA commitear el .env real.

# --- Base de datos ---
POSTGRES_USER=conteo
POSTGRES_PASSWORD=conteo_local_dev
POSTGRES_DB=conteo
DATABASE_URL=postgresql://conteo:conteo_local_dev@postgres:5432/conteo?schema=public

# --- API ---
API_PORT=4000
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# --- Web ---
# URL pública de la API que usa el navegador.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Caddy / HTTPS ---
# Para producción pon tu dominio real. "localhost" emite un cert local de desarrollo.
SITE_ADDRESS=localhost

# --- Mejora opcional con IA (la app funciona sin esto) ---
GEMINI_API_KEY=
