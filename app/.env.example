# Copiar a .env y ajustar. NUNCA commitear el .env real.

# --- Base de datos ---
POSTGRES_USER=conteo
POSTGRES_PASSWORD=conteo_local_dev
POSTGRES_DB=conteo
DATABASE_URL=postgresql://conteo:conteo_local_dev@postgres:5432/conteo?schema=public

# --- API ---
API_PORT=4000
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# --- Web ---
# URL pública de la API que usa el navegador.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Caddy / HTTPS ---
# Para producción pon tu dominio real. "localhost" emite un cert local de desarrollo.
SITE_ADDRESS=localhost

# --- Mejora opcional con IA (la app funciona sin esto) ---
GEMINI_API_KEY=

# =========================================================================
#  CREDENCIALES DE DESPLIEGUE (opcionales)
#
#  La aplicacion NO las usa en tiempo de ejecucion: son para las CLI/APIs de
#  las plataformas al publicar. Ponlas en tu .env local, que esta ignorado
#  por git.
#
#  ⚠ Este repositorio es PUBLICO por las reglas del hackathon. Nunca pongas
#    valores reales en este archivo de ejemplo.
# =========================================================================

# https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=

# https://vercel.com/account/tokens
VERCEL_TOKEN=

# https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=

# Cadena de conexion de la base de produccion (Neon).
DATABASE_URL_NEON=
