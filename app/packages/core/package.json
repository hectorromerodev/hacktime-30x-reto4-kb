{
  "name": "@conteo/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:cobertura": "node --experimental-strip-types --test --experimental-test-coverage 'src/**/*.test.ts'",
    "eval": "node --experimental-strip-types src/eval/evalFuzzy.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
