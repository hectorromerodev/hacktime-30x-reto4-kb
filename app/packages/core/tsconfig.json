{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    // El core se consume COMO FUENTE: `exports` apunta a `./src/index.ts` y
    // tanto Next (web) como `node --experimental-strip-types` (api) transpilan
    // los `.ts` directamente. No se emite `dist`; este `tsc` es solo el chequeo
    // de tipos del paquete, y para eso necesita aceptar las importaciones `.ts`.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/eval/**"]
}
